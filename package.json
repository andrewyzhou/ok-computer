{
  "name": "ok-computer",
  "version": "0.1.0",
  "private": true,
  "description": "a personal agent that lives on the owner's pc and talks to them over chat",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "chat": "tsx src/main.ts --chat",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "openai": "^7.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
