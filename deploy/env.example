# the variables of deploy/compose.yaml. copy this file to deploy/.env next to compose.yaml and fill it in. compose
# reads deploy/.env by itself, and git ignores it.

# the absolute path of the run directory on the host, for example /srv/okc. it holds okc.config.json and data/, and it
# belongs to 10001:10001.
OKC_RUN=
# the name of the server on the tailnet. the default is okc.
OKC_TS_HOSTNAME=
# a one-off tailscale auth key for the first join of the server. only the tailscale service gets it in its
# environment. the node keeps its identity in the ts-state volume, so remove the key after the first join.
TS_AUTHKEY=
# the s3 bucket that litestream writes the backup of the database to.
OKC_BACKUP_BUCKET=
# the aws region of the bucket and of secrets manager, for example us-east-1.
AWS_REGION=
# the api key of the model provider. the app also reads CLAUDE_API_KEY, which wins when both are set.
ANTHROPIC_API_KEY=
# the base url of a model server with the openai api, when the config uses one.
OPENAI_COMPAT_BASE_URL=
# the api key of that model server.
OPENAI_COMPAT_API_KEY=
# the token of the dashboard. the dashboard accepts the host name of dashboard.publicUrl only when it is set.
DASHBOARD_TOKEN=
# TELEGRAM_* is set only on the host that is live. two hosts that poll the same bot take each other's messages.
# the token of the telegram bot.
TELEGRAM_BOT_TOKEN=
# the telegram user id of the owner.
TELEGRAM_OWNER_ID=
